{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "japaneast"
    },
    "functionPlanName": {
      "type": "string",
      "defaultValue": "azlab-jissou-func-plan"
    },
    "functionAppName": {
      "type": "string",
      "defaultValue": "azlab-jissou-func"
    },
    "opeVmName": {
      "type": "string",
      "defaultValue": "azlab-jissou-ope-vm"
    },
    "staticWebAppName": {
      "type": "string",
      "defaultValue": "azlab-jissou-swa"
    },
    "storageAccountName": {
      "type": "string",
      "defaultValue": "azlabjissoufuncst"
    },
    "deploymentContainerName": {
      "type": "string",
      "defaultValue": "function-deploy"
    },
    "applicationInsightsName": {
      "type": "string",
      "defaultValue": "azlab-jissou-func-ai"
    },
    "functionSubnetResourceId": {
      "type": "string",
      "defaultValue": "/subscriptions/c9e9f3d6-7c6b-446f-b174-76556d0d25d6/resourceGroups/azlab-jissou-network-rg/providers/Microsoft.Network/virtualNetworks/azlab-jissou-vnet/subnets/azlab-jissou-func-snet"
    },
    "proxyUrl": {
      "type": "string",
      "defaultValue": "http://172.16.1.4:3128"
    },
    "maximumInstanceCount": {
      "type": "int",
      "defaultValue": 100
    },
    "instanceMemoryMB": {
      "type": "int",
      "defaultValue": 2048,
      "allowedValues": [
        512,
        2048,
        4096
      ]
    },
    "keyVaultName": {
      "type": "string",
      "defaultValue": "azlab-jissou-ap-kv",
      "minLength": 3,
      "maxLength": 24
    },
    "secretName": {
      "type": "string",
      "defaultValue": "test"
    }
  },
  "variables": {
    "storageBlobDataOwnerRoleDefinitionId": "b7e6dc6d-f1e8-4753-8033-0f276bb0955b",
    "websiteContributorRoleDefinitionId": "de139f84-1756-47ae-9be6-808fbbe84772",
    "contributorRoleDefinitionId": "b24988ac-6180-42a0-ab88-20f7382dd24c",
    "keyVaultSecretsUserRoleDefinitionId": "4633458b-17de-408a-b874-0445c86b69e6"
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2024-04-01",
      "name": "[parameters('functionPlanName')]",
      "location": "[parameters('location')]",
      "kind": "functionapp",
      "sku": {
        "name": "FC1",
        "tier": "FlexConsumption"
      },
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2024-04-01",
      "name": "[parameters('functionAppName')]",
      "location": "[parameters('location')]",
      "kind": "functionapp,linux",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', parameters('functionPlanName'))]",
        "httpsOnly": true,
        "publicNetworkAccess": "Enabled",
        "functionAppConfig": {
          "deployment": {
            "storage": {
              "type": "blobContainer",
              "value": "[concat(reference(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2024-01-01').primaryEndpoints.blob, parameters('deploymentContainerName'))]",
              "authentication": {
                "type": "SystemAssignedIdentity"
              }
            }
          },
          "runtime": {
            "name": "node",
            "version": "22"
          },
          "scaleAndConcurrency": {
            "maximumInstanceCount": "[parameters('maximumInstanceCount')]",
            "instanceMemoryMB": "[parameters('instanceMemoryMB')]"
          }
        },
        "siteConfig": {
          "appSettings": [
            {
              "name": "AzureWebJobsStorage__accountName",
              "value": "[parameters('storageAccountName')]"
            },
            {
              "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
              "value": "[reference(resourceId('Microsoft.Insights/components', parameters('applicationInsightsName')), '2020-02-02').ConnectionString]"
            },
            {
              "name": "NODE_USE_ENV_PROXY",
              "value": "1"
            },
            {
              "name": "HTTP_PROXY",
              "value": "[parameters('proxyUrl')]"
            },
            {
              "name": "HTTPS_PROXY",
              "value": "[parameters('proxyUrl')]"
            },
            {
              "name": "NO_PROXY",
              "value": "169.254.169.254,169.254.255.2,localhost,127.0.0.1,azlabjissoufuncst.blob.core.windows.net"
            },
            {
              "name": "TEST_SECRET",
              "value": "[format('@Microsoft.KeyVault(SecretUri=https://{0}.vault.azure.net/secrets/{1})', parameters('keyVaultName'), parameters('secretName'))]"
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', parameters('functionPlanName'))]"
      ]
    },
    {
      "type": "Microsoft.Web/sites/networkConfig",
      "apiVersion": "2024-04-01",
      "name": "[format('{0}/virtualNetwork', parameters('functionAppName'))]",
      "properties": {
        "subnetResourceId": "[parameters('functionSubnetResourceId')]",
        "swiftSupported": true
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('functionAppName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), resourceId('Microsoft.Web/sites', parameters('functionAppName')), variables('storageBlobDataOwnerRoleDefinitionId'))]",
      "scope": "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]",
      "properties": {
        "roleDefinitionId": "[resourceId('Microsoft.Authorization/roleDefinitions', variables('storageBlobDataOwnerRoleDefinitionId'))]",
        "principalId": "[reference(resourceId('Microsoft.Web/sites', parameters('functionAppName')), '2024-04-01', 'Full').identity.principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('functionAppName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.Web/sites', parameters('functionAppName')), parameters('opeVmName'), variables('websiteContributorRoleDefinitionId'))]",
      "scope": "[resourceId('Microsoft.Web/sites', parameters('functionAppName'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('websiteContributorRoleDefinitionId'))]",
        "principalId": "[reference(resourceId('Microsoft.Compute/virtualMachines', parameters('opeVmName')), '2023-09-01', 'Full').identity.principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('functionAppName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.Web/staticSites', parameters('staticWebAppName')), parameters('opeVmName'), variables('contributorRoleDefinitionId'))]",
      "scope": "[resourceId('Microsoft.Web/staticSites', parameters('staticWebAppName'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('contributorRoleDefinitionId'))]",
        "principalId": "[reference(resourceId('Microsoft.Compute/virtualMachines', parameters('opeVmName')), '2023-09-01', 'Full').identity.principalId]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName')), resourceId('Microsoft.Web/sites', parameters('functionAppName')), variables('keyVaultSecretsUserRoleDefinitionId'))]",
      "scope": "[resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('keyVaultSecretsUserRoleDefinitionId'))]",
        "principalId": "[reference(resourceId('Microsoft.Web/sites', parameters('functionAppName')), '2024-04-01', 'Full').identity.principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('functionAppName'))]"
      ]
    }
  ]
}
