{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "japaneast",
      "metadata": {
        "description": "ope VMを作成するリージョン"
      }
    },
    "adminUsername": {
      "type": "string",
      "metadata": {
        "description": "Linux VMの管理者ユーザー名"
      }
    },
    "adminPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Linux VMの管理者パスワード"
      }
    },
    "storageAccountName": {
      "type": "string",
      "defaultValue": "azlabjissouopestorage",
      "metadata": {
        "description": "資材取得元Storage Account名"
      },
      "minLength": 3,
      "maxLength": 24
    }
  },
  "resources": [
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2023-11-01",
      "name": "azlab-jissou-ope-nic",
      "location": "[parameters('location')]",
      "properties": {
        "ipConfigurations": [
          {
            "name": "ipconfig1",
            "properties": {
              "privateIPAllocationMethod": "Dynamic",
              "subnet": {
                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/resourceGroups/azlab-jissou-network-rg/providers/Microsoft.Network/virtualNetworks/azlab-jissou-vnet/subnets/azlab-jissou-ap-snet')]"
              }
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2023-09-01",
      "name": "azlab-jissou-ope-vm",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', 'azlab-jissou-ope-nic')]"
      ],
      "properties": {
        "hardwareProfile": {
          "vmSize": "Standard_B2ts_v2"
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "Canonical",
            "offer": "ubuntu-24_04-lts",
            "sku": "server",
            "version": "latest"
          },
          "osDisk": {
            "createOption": "FromImage",
            "managedDisk": {
              "storageAccountType": "Standard_LRS"
            }
          }
        },
        "osProfile": {
          "computerName": "azlab-ope",
          "adminUsername": "[parameters('adminUsername')]",
          "adminPassword": "[parameters('adminPassword')]",
          "customData": "",
          "linuxConfiguration": {
            "disablePasswordAuthentication": false
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', 'azlab-jissou-ope-nic')]",
              "properties": {
                "primary": true
              }
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), 'azlab-jissou-ope-vm-blob-reader')]",
      "scope": "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines', 'azlab-jissou-ope-vm')]"
      ],
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.Compute/virtualMachines', 'azlab-jissou-ope-vm'), '2023-09-01', 'Full').identity.principalId]",
        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '2a2b9908-6ea1-4ae2-8e65-a410df84e7d1')]"
      }
    },
    {
      "type": "Microsoft.DevTestLab/schedules",
      "apiVersion": "2018-09-15",
      "name": "shutdown-computevm-azlab-jissou-ope-vm",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines', 'azlab-jissou-ope-vm')]"
      ],
      "properties": {
        "status": "Enabled",
        "taskType": "ComputeVmShutdownTask",
        "targetResourceId": "[resourceId('Microsoft.Compute/virtualMachines', 'azlab-jissou-ope-vm')]",
        "dailyRecurrence": {
          "time": "1200"
        },
        "timeZoneId": "Tokyo Standard Time",
        "notificationSettings": {
          "status": "Disabled",
          "timeInMinutes": 30
        }
      }
    }
  ]
}
