{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "japaneast",
      "metadata": {
        "description": "Region for the Function storage private endpoint"
      }
    },
    "storageAccountName": {
      "type": "string",
      "defaultValue": "azlabjissoufuncst",
      "metadata": {
        "description": "Function storage account name"
      },
      "minLength": 3,
      "maxLength": 24
    }
  },
  "resources": [
    {
      "type": "Microsoft.Network/privateDnsZones",
      "apiVersion": "2020-06-01",
      "name": "privatelink.blob.core.windows.net",
      "location": "global",
      "properties": {}
    },
    {
      "type": "Microsoft.Network/privateDnsZones/virtualNetworkLinks",
      "apiVersion": "2020-06-01",
      "name": "privatelink.blob.core.windows.net/azlab-jissou-vnet-link",
      "location": "global",
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateDnsZones', 'privatelink.blob.core.windows.net')]"
      ],
      "properties": {
        "registrationEnabled": false,
        "virtualNetwork": {
          "id": "[concat('/subscriptions/', subscription().subscriptionId, '/resourceGroups/azlab-jissou-network-rg/providers/Microsoft.Network/virtualNetworks/azlab-jissou-vnet')]"
        }
      }
    },
    {
      "type": "Microsoft.Network/privateEndpoints",
      "apiVersion": "2023-11-01",
      "name": "azlab-jissou-function-storage-pe",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateDnsZones', 'privatelink.blob.core.windows.net')]"
      ],
      "properties": {
        "subnet": {
          "id": "[concat('/subscriptions/', subscription().subscriptionId, '/resourceGroups/azlab-jissou-network-rg/providers/Microsoft.Network/virtualNetworks/azlab-jissou-vnet/subnets/azlab-jissou-pe-snet')]"
        },
        "privateLinkServiceConnections": [
          {
            "name": "function-storage-blob-connection",
            "properties": {
              "privateLinkServiceId": "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]",
              "groupIds": [
                "blob"
              ]
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/privateEndpoints/privateDnsZoneGroups",
      "apiVersion": "2023-11-01",
      "name": "azlab-jissou-function-storage-pe/default",
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateEndpoints', 'azlab-jissou-function-storage-pe')]",
        "[resourceId('Microsoft.Network/privateDnsZones', 'privatelink.blob.core.windows.net')]"
      ],
      "properties": {
        "privateDnsZoneConfigs": [
          {
            "name": "blob-zone-config",
            "properties": {
              "privateDnsZoneId": "[resourceId('Microsoft.Network/privateDnsZones', 'privatelink.blob.core.windows.net')]"
            }
          }
        ]
      }
    }
  ]
}
