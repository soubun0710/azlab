{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "japaneast",
      "metadata": {
        "description": "プロキシVMを作成するリージョン"
      }
    },
    "adminUsername": {
      "type": "string",
      "metadata": {
        "description": "Linux VMの管理者ユーザー名"
      }
    },
    "adminPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Linux VMの管理者パスワード"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2023-11-01",
      "name": "azlab-tousei-proxy-pip",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard",
        "tier": "Regional"
      },
      "properties": {
        "publicIPAllocationMethod": "Static",
        "publicIPAddressVersion": "IPv4"
      }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2023-11-01",
      "name": "azlab-tousei-proxy-nic",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/publicIPAddresses', 'azlab-tousei-proxy-pip')]"
      ],
      "properties": {
        "ipConfigurations": [
          {
            "name": "ipconfig1",
            "properties": {
              "privateIPAllocationMethod": "Static",
              "privateIPAddress": "172.16.1.4",
              "subnet": {
                "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', 'azlab-tousei-vnet', 'azlab-tousei-snet')]"
              },
              "publicIPAddress": {
                "id": "[resourceId('Microsoft.Network/publicIPAddresses', 'azlab-tousei-proxy-pip')]"
              }
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2023-09-01",
      "name": "azlab-tousei-proxy-vm",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', 'azlab-tousei-proxy-nic')]"
      ],
      "properties": {
        "hardwareProfile": {
          "vmSize": "Standard_B2ts_v2"
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "Canonical",
            "offer": "0001-com-ubuntu-server-jammy",
            "sku": "22_04-lts-gen2",
            "version": "latest"
          },
          "osDisk": {
            "createOption": "FromImage",
            "managedDisk": {
              "storageAccountType": "Standard_LRS"
            }
          }
        },
        "osProfile": {
          "computerName": "azlab-proxy",
          "adminUsername": "[parameters('adminUsername')]",
          "adminPassword": "[parameters('adminPassword')]",
          "customData": "",
          "linuxConfiguration": {
            "disablePasswordAuthentication": false
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', 'azlab-tousei-proxy-nic')]",
              "properties": {
                "primary": true
              }
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.DevTestLab/schedules",
      "apiVersion": "2018-09-15",
      "name": "shutdown-computevm-azlab-tousei-proxy-vm",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines', 'azlab-tousei-proxy-vm')]"
      ],
      "properties": {
        "status": "Enabled",
        "taskType": "ComputeVmShutdownTask",
        "targetResourceId": "[resourceId('Microsoft.Compute/virtualMachines', 'azlab-tousei-proxy-vm')]",
        "dailyRecurrence": {
          "time": "1200"
        },
        "timeZoneId": "Tokyo Standard Time",
        "notificationSettings": {
          "status": "Disabled",
          "timeInMinutes": 30
        }
      }
    }
  ]
}
